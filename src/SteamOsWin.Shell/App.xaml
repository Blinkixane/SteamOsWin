<Application x:Class="SteamOsWin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0E14" />
        <SolidColorBrush x:Key="PanelBrush" Color="#121722" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#192131" />
        <SolidColorBrush x:Key="TextBrush" Color="#F2F6FA" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8E9AAF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#1A9FFF" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#143B5C" />
    </Application.Resources>
</Application>

